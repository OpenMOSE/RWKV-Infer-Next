# RWKV-Infer-Next settings. Every key can also be set from the WebUI (/ui -> Settings & status).
# A Hugging Face style model folder (safetensors + chat_template.jinja), a .safetensors file or an RWKV-7 .pth
RWKV_MODEL_PATH=/path/to/RWKV7-G1l-7.2B-20261031
RWKV_QUANT=int6
RWKV_TP=1
#RWKV_DEVICES=0,1
RWKV_MAX_BATCH=32
RWKV_GRAPH_BATCH_SIZES=1,2,4,8,16,32
RWKV_COMPILE=1
# auto: use mtp/ (or *.mtp.safetensors / *.mtp.pt) from the model folder
RWKV_MTP_PATH=auto
RWKV_CHAT_TEMPLATE=auto
RWKV_THINKING_DEFAULT=0
RWKV_PORT=8000
